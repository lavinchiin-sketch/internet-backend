{
  "name": "internet-backend",
  "version": "2.0.0",
  "description": "INTERNet: A Data-Driven Monitoring and Analytics System for OJT — Backend (Node.js + Express + MySQL)",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/config/initDb.js",
    "db:reset": "node src/config/initDb.js --reset",
    "db:seed": "node src/scripts/seed.js",
    "admin:create": "node src/scripts/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
